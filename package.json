{
  "name": "art",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate:local": "wrangler d1 migrations apply art-storefront-db --local",
    "db:seed:local": "wrangler d1 execute art-storefront-db --local --file=db/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply art-storefront-db --remote",
    "db:seed:remote": "wrangler d1 execute art-storefront-db --remote --file=db/seed.sql",
    "deploy": "astro build && wrangler pages deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^5.18.2",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "wrangler": "^4.100.0"
  }
}
